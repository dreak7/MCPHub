# At least one key is required for a key-protected provider.
# 多 key 轮换：`api_key_envs` 里按顺序排优先级，第一把额度耗尽/冷却后自动用下一把。
TAVILY_API_KEY=
# 第二把（可选，必须来自不同账号才有额外额度）；留空即停用
TAVILY_API_KEY_2=
EXA_API_KEY=
JINA_API_KEY=
ANYSEARCH_API_KEY=
BOCHA_API_KEY=
# Context7 programming docs API key (https://context7.com/dashboard; 1,000 free calls/month; optional for testing)
CONTEXT7_API_KEY=
# TDX (通达信) 金融数据 API Token
TDX_API_KEY=
